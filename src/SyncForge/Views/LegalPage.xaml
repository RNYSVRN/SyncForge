<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncForge.Views.LegalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:SyncForge.Views"
    xmlns:controls="using:SyncForge.Controls"
    Background="Transparent">

    <Grid Padding="36,24,36,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock MaxWidth="1000" HorizontalAlignment="Stretch" x:Uid="Legal_Title" Text="Lizenzen &amp; Rechtliches" Style="{StaticResource TitleTextBlockStyle}" />

        <SelectorBar Grid.Row="1" MaxWidth="1000" HorizontalAlignment="Stretch" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem x:Uid="Legal_TabApp" Text="SyncForge" Tag="App" IsSelected="True" />
            <SelectorBarItem x:Uid="Legal_TabPrivacy" Text="Datenschutz" Tag="Privacy" />
            <SelectorBarItem x:Uid="Legal_TabThirdParty" Text="Drittanbieter" Tag="ThirdParty" />
        </SelectorBar>

        <ScrollViewer x:Name="Scroller" Grid.Row="2">
            <Grid Padding="0,8,0,36">
                <!-- SyncForge: Copyright + Nutzungsbedingungen -->
                <StackPanel x:Name="AppPanel" MaxWidth="1000" Spacing="12">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="ms-appx:///Assets/AppIcon.png" Width="56" Height="56" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="SyncForge" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Uid="Legal_Copyright" Text="© 2026 Ronny Severin. Alle Rechte vorbehalten." IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <controls:MarkdownView x:Name="EulaView" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Datenschutz -->
                <controls:MarkdownView x:Name="PrivacyView" MaxWidth="1000" Visibility="Collapsed" />

                <!-- Drittanbieter -->
                <StackPanel x:Name="ThirdPartyPanel" MaxWidth="1000" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Uid="Legal_ThirdPartyIntro" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="SyncForge verwendet die folgenden Komponenten. Wir danken allen Autorinnen und Autoren. Die vollständigen Lizenztexte sind hier aufgeführt." />
                    <ItemsControl x:Name="ComponentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:ComponentItem">
                                <toolkit:SettingsExpander Header="{x:Bind Name}" Description="{x:Bind Detail}" Margin="0,0,0,4">
                                    <toolkit:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE943;" />
                                    </toolkit:SettingsExpander.HeaderIcon>
                                    <TextBlock Text="{x:Bind License}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <toolkit:SettingsExpander.Items>
                                        <toolkit:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <HyperlinkButton Content="{x:Bind Url}" NavigateUri="{x:Bind Uri}" Padding="4,2" />
                                                    <Button Tag="{x:Bind}" Click="OpenLicense_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                                            <TextBlock Text="{x:Bind OpenText}" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind PackagesText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="12"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                                                        <TextBlock Text="{x:Bind Preview}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    </ScrollViewer>
                                                </Border>
                                            </StackPanel>
                                        </toolkit:SettingsCard>
                                    </toolkit:SettingsExpander.Items>
                                </toolkit:SettingsExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
