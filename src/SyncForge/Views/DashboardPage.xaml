<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncForge.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SyncForge.ViewModels"
    Background="Transparent">

    <!-- Grid zwischen ScrollViewer und StackPanel: zentrierte Maximalbreite wird bei Größenänderung neu berechnet. -->
    <ScrollViewer>
        <Grid Padding="{StaticResource PageMargin}">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="Dashboard_Title" Text="Übersicht" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Uid="Dashboard_Subtitle" Text="Alle Backup-Profile auf einen Blick: Status, letzter und nächster Lauf." Style="{StaticResource PageSubtitleTextBlockStyle}" />
                </StackPanel>
                <Button x:Name="SyncAllButton" x:Uid="Dashboard_SyncAllButton" Grid.Column="1" Click="SyncAll_Click" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock x:Uid="Dashboard_SyncAll" Text="Alle synchronisieren" />
                    </StackPanel>
                </Button>
                <Button x:Name="NewProfileButton" x:Uid="Dashboard_NewProfileButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="NewProfile_Click" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="Dashboard_NewProfileText" Text="Neues Profil" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="True" Severity="Success" CloseButtonClick="UpdateBar_CloseButtonClick">
                <InfoBar.ActionButton>
                    <Button x:Uid="Update_OpenPage" Content="Download-Seite öffnen" Click="OpenUpdatePage_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="AttentionBar" IsOpen="False" IsClosable="False" Severity="Warning" />

            <!-- Noch kein Profil: freundlicher Einstieg statt leerer Kacheln -->
            <Border x:Name="EmptyState" Style="{StaticResource CardBorderStyle}" Padding="40" Visibility="Collapsed">
                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="520">
                    <FontIcon Glyph="&#xE8F7;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Uid="Dashboard_EmptyTitle" Text="Willkommen bei SyncForge" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Uid="Dashboard_EmptyText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Lege ein Backup-Profil an: Wähle einen oder mehrere Ordner und ein Ziel, zum Beispiel eine USB-Festplatte oder dein NAS. Vor jedem Lauf siehst du, was passieren wird." />
                    <Button x:Uid="Dashboard_CreateFirstButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="NewProfile_Click" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock x:Uid="Dashboard_CreateFirst" Text="Erstes Profil anlegen" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Kennzahlen -->
            <Grid x:Name="StatsGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE895;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="Dashboard_ProfilesCard" Text="Backup-Profile" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ProfileCountText" Text="0" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE81C;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="Dashboard_LastRunCard" Text="Letzter Lauf" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LastRunText" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LastRunDetail" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE823;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="Dashboard_NextRunCard" Text="Nächster Lauf" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="NextRunText" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="NextRunDetail" x:Uid="Dashboard_NoSchedule" Text="Kein Zeitplan" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Profilkarten -->
            <TextBlock x:Name="ProfilesHeader" x:Uid="Dashboard_YourProfiles" Text="Deine Profile" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,8,0,0" />
            <ItemsRepeater x:Name="ProfileCards">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="320" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:DashboardProfileViewModel">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" Style="{x:Bind StatusStyle, Mode=OneWay}" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Route, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Route, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind LastRunLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind NextRunLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Läuft gerade: Fortschritt statt Schaltflächen -->
                                <StackPanel Grid.Row="3" Spacing="6" Visibility="{x:Bind IsRunning, Mode=OneWay}">
                                    <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ActivityText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsIdle, Mode=OneWay}">
                                    <Button Tag="{x:Bind}" Click="Run_Click" Style="{StaticResource AccentButtonStyle}" x:Uid="Dashboard_RunNow" Content="Jetzt synchronisieren" />
                                    <Button Tag="{x:Bind}" Click="Preview_Click" x:Uid="Dashboard_Preview" Content="Vorschau" />
                                    <Button Tag="{x:Bind}" Click="Edit_Click" x:Uid="Dashboard_Edit" ToolTipService.ToolTip="Bearbeiten">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
