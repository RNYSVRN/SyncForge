<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncForge.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="Dashboard_Title" Text="Übersicht" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar x:Uid="Dashboard_Welcome" IsOpen="True" IsClosable="True" Severity="Informational"
                     Title="Willkommen bei SyncForge" Message="Lege ein Backup-Profil an, um Ordner in ein oder mehrere Ziele zu synchronisieren." />

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE895;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="Dashboard_ProfilesCard" Text="Backup-Profile" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ProfileCountText" Text="0" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE81C;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="Dashboard_LastRunCard" Text="Letzter Lauf" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LastRunText" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LastRunDetail" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE823;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="Dashboard_NextRunCard" Text="Nächster Lauf" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="NextRunText" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="NextRunDetail" x:Uid="Dashboard_NoSchedule" Text="Zeitpläne folgen in Etappe 4" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Button x:Uid="Dashboard_NewProfile" Style="{StaticResource AccentButtonStyle}" Click="NewProfile_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Uid="Dashboard_NewProfileText" Text="Neues Profil" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
