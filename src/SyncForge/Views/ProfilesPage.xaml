<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncForge.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SyncForge.ViewModels"
    Background="Transparent">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid MaxWidth="1000">
            <TextBlock x:Uid="Profiles_Title" Text="Backup-Profile" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:Uid="Profiles_AddButton" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="Add_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Uid="Profiles_Add" Text="Profil hinzufügen" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Profilliste -->
        <ListView
            Grid.Row="1"
            MaxWidth="1000"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="Profile_ItemClick"
            Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileItemViewModel">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="20" VerticalAlignment="Center"
                                      Style="{x:Bind StatusStyle}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Route}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Route}" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind ModeText}" /><Run Text="  ·  " /><Run Text="{x:Bind LastRunText}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Uid="Profiles_Preview" Content="Vorschau" Tag="{x:Bind}" Click="Preview_Click" />
                                <Button x:Uid="Profiles_SyncNow" Content="Synchronisieren" Tag="{x:Bind}" Click="Run_Click"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button Tag="{x:Bind}" Padding="8" Background="Transparent" BorderThickness="0"
                                        x:Uid="Profiles_More" ToolTipService.ToolTip="Weitere Optionen">
                                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem x:Uid="Profiles_Edit" Text="Bearbeiten" Tag="{x:Bind}" Click="Edit_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Profiles_Versions" Text="Versionen" Tag="{x:Bind}" Click="Versions_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Profiles_Duplicate" Text="Duplizieren" Tag="{x:Bind}" Click="Duplicate_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem x:Uid="Profiles_Delete" Text="Löschen" Tag="{x:Bind}" Click="Delete_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Leerer Zustand -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE895;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Uid="Profiles_EmptyTitle" Text="Noch keine Profile" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Uid="Profiles_EmptyText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Ein Profil legt fest, welche Ordner wohin synchronisiert werden, in welchem Modus und wann." />
            <Button x:Uid="Profiles_EmptyAdd" Content="Erstes Profil anlegen" HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}" Click="Add_Click" />
        </StackPanel>
    </Grid>
</Page>
