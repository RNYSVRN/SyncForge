<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncForge.Views.ConflictsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SyncForge.ViewModels"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <Grid Padding="{StaticResource PageMargin}">
                <StackPanel MaxWidth="1000" Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="Conflicts_Title" Text="Konflikte lösen" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock x:Uid="Conflicts_Intro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Diese Dateien wurden seit dem letzten Lauf auf beiden Seiten geändert. Wähle je Datei, welche Fassung gilt. Ersetzte Fassungen landen im Papierkorb bzw. im Versionsordner." />

                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Margin="0,8,0,0">
                        <ProgressRing IsActive="True" Width="20" Height="20" />
                        <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>

                    <InfoBar IsOpen="{x:Bind ViewModel.ShowMessage, Mode=TwoWay}" IsClosable="True"
                             Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}" Message="{x:Bind ViewModel.MessageText, Mode=OneWay}" />

                    <InfoBar x:Uid="Conflicts_None" IsOpen="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" IsClosable="False" Severity="Success"
                             Title="Keine offenen Konflikte" Message="Beide Seiten sind sich einig." />

                    <!-- Für alle -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasConflicts, Mode=OneWay}">
                        <DropDownButton x:Uid="Conflicts_SetAll" Content="Für alle übernehmen">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem x:Uid="Conflicts_AllNewer" Text="Jeweils neuere Fassung" Tag="Newer" Click="SetAll_Click" />
                                    <MenuFlyoutItem x:Uid="Conflicts_AllSource" Text="Quelle behalten" Tag="KeepSource" Click="SetAll_Click" />
                                    <MenuFlyoutItem x:Uid="Conflicts_AllTarget" Text="Ziel behalten" Tag="KeepTarget" Click="SetAll_Click" />
                                    <MenuFlyoutItem x:Uid="Conflicts_AllBoth" Text="Beide behalten" Tag="KeepBoth" Click="SetAll_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Uid="Conflicts_AllSkip" Text="Später entscheiden" Tag="Skip" Click="SetAll_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <!-- Konflikte je Ziel -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}" Visibility="{x:Bind ViewModel.HasConflicts, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConflictGroupViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,12">
                                    <TextBlock Text="{x:Bind TargetPath}" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,8,0,4"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind TargetPath}" />
                                    <ItemsControl ItemsSource="{x:Bind Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ConflictItemViewModel">
                                                <Border Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,4">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Center"
                                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                                            <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind TargetText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock x:Uid="Conflicts_TypeConflict" Visibility="{x:Bind IsTypeConflict}" TextWrapping="Wrap"
                                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                       Text="Ordner auf der einen, Datei auf der anderen Seite. Bitte im Explorer umbenennen oder entfernen." />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="2" SelectedIndex="{x:Bind ChoiceIndex, Mode=TwoWay}" MinWidth="200" VerticalAlignment="Center"
                                                                  IsEnabled="{x:Bind CanResolve}" x:Uid="Conflicts_Choice">
                                                            <ComboBoxItem x:Uid="Resolve_Skip" Content="Später entscheiden" />
                                                            <ComboBoxItem x:Uid="Resolve_KeepSource" Content="Quelle behalten" />
                                                            <ComboBoxItem x:Uid="Resolve_KeepTarget" Content="Ziel behalten" />
                                                            <ComboBoxItem x:Uid="Resolve_KeepBoth" Content="Beide behalten" />
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="36,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Uid="Conflicts_Back" Content="Zurück" Click="Back_Click" MinWidth="120">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Escape" /></Button.KeyboardAccelerators>
                </Button>
                <Button x:Uid="Conflicts_Apply" Content="Übernehmen" Click="Apply_Click" MinWidth="120" Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.HasConflicts, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
