<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncForge.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SyncForge.ViewModels"
    xmlns:controls="using:SyncForge.Controls"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="TileValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer Visibility="{x:Bind ViewModel.HasRuns, Mode=OneWay}">
            <Grid Padding="{StaticResource PageMargin}">
                <StackPanel MaxWidth="1000" Spacing="16">
                    <!-- Kopf mit Filtern -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="History_Title" Text="Historie" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                                  ItemsSource="{x:Bind ViewModel.ProfileFilters}"
                                  SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                                  x:Uid="History_ProfileFilter" AutomationProperties.Name="Profil" />
                        <ComboBox Grid.Column="2" MinWidth="160" VerticalAlignment="Center"
                                  ItemsSource="{x:Bind ViewModel.StatusFilters}"
                                  SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                                  x:Uid="History_StatusFilter" AutomationProperties.Name="Status" />
                        <Button Grid.Column="3" VerticalAlignment="Center" Click="Export_Click"
                                x:Uid="History_Export" ToolTipService.ToolTip="Läufe des aktuellen Filters als CSV-Datei speichern">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDE1;" FontSize="16" />
                                <TextBlock x:Uid="History_ExportText" Text="Exportieren…" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Kennzahlen (letzte 30 Tage) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="History_TileRuns" Text="Läufe (30 Tage)" Style="{StaticResource TileLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.RunsTileText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="History_TileSuccess" Text="Erfolgsquote" Style="{StaticResource TileLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SuccessTileText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="History_TileBytes" Text="Übertragene Daten" Style="{StaticResource TileLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.BytesTileText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="History_TileDuration" Text="Ø Dauer" Style="{StaticResource TileLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.DurationTileText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Diagramm -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="History_ChartTitle" Text="Übertragene Daten pro Tag" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="History_ChartSubtitle" Text="Letzte 30 Tage" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <controls:DailyBarChart x:Name="Chart" />
                        </StackPanel>
                    </Border>

                    <!-- Läufe -->
                    <TextBlock x:Uid="History_RunsHeader" Text="Läufe" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,8,0,0" />
                    <TextBlock x:Uid="History_NoMatches" Text="Keine Läufe für diesen Filter."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind NoMatches(ViewModel.Runs.Count), Mode=OneWay}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Runs}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Run_ItemClick"
                              Padding="0" Margin="0,-12,0,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunItemViewModel">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="16,10">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="18" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  ToolTipService.ToolTip="{x:Bind StatusText}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{x:Bind ProfileName}" /><Run Text="  ·  " Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><Run Text="{x:Bind StatusText}" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind SummaryText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock Text="{x:Bind DateText}" HorizontalAlignment="Right" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind BytesText}" /><Run Text=" · " /><Run Text="{x:Bind DurationText}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Uid="History_LoadMore" Content="Weitere laden" HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}" Click="LoadMore_Click" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Leerer Zustand -->
        <Grid Padding="{StaticResource PageMargin}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <TextBlock x:Uid="History_Title" Text="Historie" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Top" MaxWidth="1000" HorizontalAlignment="Stretch" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
                <FontIcon Glyph="&#xE81C;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Uid="History_EmptyTitle" Text="Noch keine Läufe" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Uid="History_EmptyText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Hier erscheinen alle Synchronisierungsläufe mit Details zu jeder Datei." />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
