<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncForge.Views.RunDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SyncForge.ViewModels"
    Background="Transparent">

    <Grid Padding="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf, Zusammenfassung und Ziele -->
        <StackPanel MaxWidth="1000" Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}" FontSize="28" VerticalAlignment="Center"
                          Style="{x:Bind ViewModel.StatusStyle, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Center" Click="Export_Click" x:Uid="Detail_Export"
                        ToolTipService.ToolTip="Angezeigte Dateiliste als CSV-Datei speichern"
                        IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}" Visibility="{x:Bind ShowIf(ViewModel.NotFound), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                        <TextBlock x:Uid="Detail_ExportText" Text="Dateiliste exportieren…" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" VerticalAlignment="Center" Click="Delete_Click" x:Uid="Detail_Delete"
                        ToolTipService.ToolTip="Eintrag löschen" Visibility="{x:Bind ShowIf(ViewModel.NotFound), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock x:Uid="Detail_DeleteText" Text="Eintrag löschen" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" TextWrapping="Wrap" />

            <InfoBar x:Uid="Detail_ConflictsBar" IsOpen="{x:Bind ViewModel.CanResolveConflicts, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Title="Offene Konflikte" Message="Einige Dateien wurden auf beiden Seiten geändert und warten auf deine Entscheidung.">
                <InfoBar.ActionButton>
                    <Button x:Uid="Detail_ResolveConflicts" Content="Konflikte lösen" Click="ResolveConflicts_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Targets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TargetEntryViewModel">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,10" Margin="0,0,0,4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="18" VerticalAlignment="Center"
                                          Style="{x:Bind StatusStyle}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Path}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Path}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind StatusText}" /><Run Text="  ·  " /><Run Text="{x:Bind SummaryText}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Tag="{x:Bind Path}" Click="OpenFolder_Click" IsEnabled="{x:Bind CanOpen}" VerticalAlignment="Center"
                                        x:Uid="Detail_OpenFolder" ToolTipService.ToolTip="Ordner öffnen">
                                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Filterzeile -->
        <Grid Grid.Row="1" MaxWidth="1000" ColumnSpacing="8" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="KindSelector" SelectionChanged="KindSelector_SelectionChanged">
                <SelectorBarItem x:Uid="Detail_FilterAll" Text="Alle" Tag="All" IsSelected="True" />
                <SelectorBarItem x:Uid="Detail_FilterNew" Text="Neu" Tag="New" />
                <SelectorBarItem x:Uid="Detail_FilterUpdated" Text="Geändert" Tag="Updated" />
                <SelectorBarItem x:Uid="Detail_FilterDeleted" Text="Gelöscht" Tag="Deleted" />
                <SelectorBarItem x:Uid="Detail_FilterErrors" Text="Fehler" Tag="Errors" />
                <SelectorBarItem x:Uid="Detail_FilterConflicts" Text="Konflikte" Tag="Conflicts" />
            </SelectorBar>
            <ComboBox Grid.Column="1" MinWidth="200" MaxWidth="320" VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.TargetFilters}" SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}"
                      Visibility="{x:Bind ViewModel.ShowTargetFilter, Mode=OneWay}" />
            <TextBox Grid.Column="2" Width="240" VerticalAlignment="Center" x:Uid="Detail_Search" PlaceholderText="Dateien durchsuchen"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Dateiliste (virtualisiert) -->
        <Grid Grid.Row="2" MaxWidth="1000" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind ViewModel.FilesCountText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="1,0,0,4" />
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0" CornerRadius="8,8,0,0" BorderThickness="1,1,1,0">
                <Grid>
                    <ListView ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="None" Padding="0,4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileItemViewModel">
                                <Grid ColumnSpacing="12" Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTipService.ToolTip="{x:Bind Path}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="360" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Detail}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Uid="Detail_NoFiles" Text="Keine Einträge für diesen Filter." HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.HasNoFiles, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
