<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncForge.Views.ProfileEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:SyncForge.ViewModels"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <Grid Padding="{StaticResource PageMargin}">
                <StackPanel MaxWidth="1000" Spacing="{StaticResource SettingsCardSpacing}">
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

                    <InfoBar Severity="Error" IsClosable="False" Margin="0,8,0,0"
                             IsOpen="{x:Bind ViewModel.HasValidationMessage, Mode=OneWay}"
                             Message="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}" />

                    <!-- Allgemein -->
                    <TextBlock x:Uid="Editor_SectionGeneral" Text="Allgemein" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <toolkit:SettingsCard x:Uid="Editor_Name" Header="Name" Description="Wird in der Liste und in Benachrichtigungen angezeigt.">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AC;" /></toolkit:SettingsCard.HeaderIcon>
                        <TextBox Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="280" x:Uid="Editor_NameBox" PlaceholderText="z. B. Dokumente auf NAS" />
                    </toolkit:SettingsCard>

                    <!-- Quelle -->
                    <TextBlock x:Uid="Editor_SectionSource" Text="Quellen" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <toolkit:SettingsExpander x:Uid="Editor_Sources" Header="Quellordner" Description="Diese Ordner werden mit allen Unterordnern synchronisiert."
                                              IsExpanded="True">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></toolkit:SettingsExpander.HeaderIcon>
                        <Button x:Uid="Editor_AddSource" Click="AddSource_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock x:Uid="Editor_AddSourceText" Text="Quelle hinzufügen" />
                            </StackPanel>
                        </Button>
                        <toolkit:SettingsExpander.ItemsHeader>
                            <StackPanel>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Sources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SourceItemViewModel">
                                            <Grid ColumnSpacing="8" RowSpacing="4" Padding="58,8,16,8" BorderThickness="0,1,0,0"
                                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind HasHint, Mode=OneWay}">
                                                    <FontIcon Glyph="{x:Bind HintGlyph, Mode=OneWay}" Foreground="{x:Bind HintBrush, Mode=OneWay}" FontSize="12" />
                                                    <TextBlock Text="{x:Bind HintText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBox Text="{x:Bind Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Uid="Editor_PathBox"
                                                         PlaceholderText="C:\Benutzer\Name\Dokumente" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Tag="{x:Bind}" Click="SourceCredentials_Click" VerticalAlignment="Center"
                                                        Visibility="{x:Bind IsNetworkPath, Mode=OneWay}"
                                                        x:Uid="Editor_Credentials" ToolTipService.ToolTip="Anmeldedaten für die Netzwerkfreigabe">
                                                    <FontIcon Glyph="&#xE8D7;" FontSize="16" />
                                                </Button>
                                                <Button Grid.Column="2" Tag="{x:Bind}" Click="BrowseSource_Click" VerticalAlignment="Center"
                                                        x:Uid="Editor_BrowseTarget" ToolTipService.ToolTip="Durchsuchen">
                                                    <FontIcon Glyph="&#xED25;" FontSize="16" />
                                                </Button>
                                                <Button Grid.Column="3" Tag="{x:Bind}" Click="RemoveSource_Click" VerticalAlignment="Center"
                                                        x:Uid="Editor_RemoveSource" ToolTipService.ToolTip="Quelle entfernen">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                                </Button>
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{x:Bind SubfolderText, Mode=OneWay}" Visibility="{x:Bind ShowSubfolder, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <InfoBar x:Uid="Editor_MultiSourceInfo" IsOpen="{x:Bind ViewModel.HasMultipleSources, Mode=OneWay}" IsClosable="False" Severity="Informational"
                                         Margin="58,4,16,8" Message="Jede Quelle landet in einem eigenen Unterordner der Ziele. Bereits vorhandene Dateien im Ziel bleiben unverändert." />
                            </StackPanel>
                        </toolkit:SettingsExpander.ItemsHeader>
                    </toolkit:SettingsExpander>

                    <!-- Ziele -->
                    <TextBlock x:Uid="Editor_SectionTargets" Text="Ziele" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <toolkit:SettingsExpander x:Uid="Editor_Targets" Header="Zielordner" Description="Lokale Laufwerke, USB-Laufwerke, Netzwerkfreigaben (\\server\freigabe) oder Cloud-Ordner."
                                              IsExpanded="True">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8DA;" /></toolkit:SettingsExpander.HeaderIcon>
                        <Button x:Uid="Editor_AddTarget" Click="AddTarget_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock x:Uid="Editor_AddTargetText" Text="Ziel hinzufügen" />
                            </StackPanel>
                        </Button>
                        <toolkit:SettingsExpander.ItemsHeader>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Targets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TargetItemViewModel">
                                        <Grid ColumnSpacing="8" Padding="58,8,16,8" BorderThickness="0,1,0,0"
                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" Visibility="{x:Bind HasHint, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind HintGlyph, Mode=OneWay}" Foreground="{x:Bind HintBrush, Mode=OneWay}" FontSize="12" />
                                                <TextBlock Text="{x:Bind HintText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBox Text="{x:Bind Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="D:\Backup" VerticalAlignment="Center"
                                                     x:Uid="Editor_TargetPathBox" />
                                            <Button Grid.Column="1" Tag="{x:Bind}" Click="TargetCredentials_Click" VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsNetworkPath, Mode=OneWay}"
                                                    x:Uid="Editor_Credentials" ToolTipService.ToolTip="Anmeldedaten für die Netzwerkfreigabe">
                                                <FontIcon Glyph="&#xE8D7;" FontSize="16" />
                                            </Button>
                                            <Button Grid.Column="2" Tag="{x:Bind}" Click="BrowseTarget_Click" VerticalAlignment="Center"
                                                    x:Uid="Editor_BrowseTarget" ToolTipService.ToolTip="Durchsuchen">
                                                <FontIcon Glyph="&#xED25;" FontSize="16" />
                                            </Button>
                                            <ToggleSwitch Grid.Column="3" IsOn="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"
                                                          OnContent="" OffContent="" x:Uid="Editor_TargetEnabled" ToolTipService.ToolTip="Ziel aktiv" />
                                            <Button Grid.Column="4" Tag="{x:Bind}" Click="RemoveTarget_Click" VerticalAlignment="Center"
                                                    x:Uid="Editor_RemoveTarget" ToolTipService.ToolTip="Ziel entfernen">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </toolkit:SettingsExpander.ItemsHeader>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Uid="Editor_MultiTarget" Header="Mehrere Ziele" Description="Ziele nacheinander oder gleichzeitig synchronisieren. Nicht erreichbare Ziele werden übersprungen.">
                                <ComboBox SelectedIndex="{x:Bind ViewModel.MultiTargetIndex, Mode=TwoWay}" MinWidth="200">
                                    <ComboBoxItem x:Uid="MultiTarget_Sequential" Content="Nacheinander" />
                                    <ComboBoxItem x:Uid="MultiTarget_Parallel" Content="Gleichzeitig" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <!-- Synchronisierung -->
                    <TextBlock x:Uid="Editor_SectionSync" Text="Synchronisierung" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <toolkit:SettingsExpander x:Uid="Editor_Mode" Header="Modus" Description="{x:Bind ViewModel.ModeDescription, Mode=OneWay}"
                                              IsExpanded="{x:Bind ViewModel.HasModeOptions, Mode=OneWay}">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8AB;" /></toolkit:SettingsExpander.HeaderIcon>
                        <ComboBox SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}" MinWidth="200">
                            <ComboBoxItem x:Uid="Mode_MirrorItem" Content="Spiegeln" />
                            <ComboBoxItem x:Uid="Mode_VersionedItem" Content="Versioniert" />
                            <ComboBoxItem x:Uid="Mode_TwoWayItem" Content="Zwei-Wege" />
                        </ComboBox>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Uid="Editor_VersionsToKeep" Header="Fassungen je Datei behalten" Description="0 = unbegrenzt"
                                                  Visibility="{x:Bind ViewModel.IsVersioned, Mode=OneWay}">
                                <NumberBox Value="{x:Bind ViewModel.VersionsToKeep, Mode=TwoWay}" Minimum="0" Maximum="1000" SpinButtonPlacementMode="Inline" MinWidth="140" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Uid="Editor_VersionMaxAge" Header="Fassungen entfernen nach (Tagen)" Description="0 = nie"
                                                  Visibility="{x:Bind ViewModel.IsVersioned, Mode=OneWay}">
                                <NumberBox Value="{x:Bind ViewModel.VersionMaxAgeDays, Mode=TwoWay}" Minimum="0" Maximum="3650" SpinButtonPlacementMode="Inline" MinWidth="140" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Uid="Editor_Conflict" Header="Bei Konflikten" Description="Wenn eine Datei seit dem letzten Lauf auf beiden Seiten geändert wurde."
                                                  Visibility="{x:Bind ViewModel.IsTwoWay, Mode=OneWay}">
                                <ComboBox SelectedIndex="{x:Bind ViewModel.ConflictIndex, Mode=TwoWay}" MinWidth="220">
                                    <ComboBoxItem x:Uid="Conflict_NewerWins" Content="Neuere Fassung gewinnt" />
                                    <ComboBoxItem x:Uid="Conflict_SourceWins" Content="Quelle gewinnt" />
                                    <ComboBoxItem x:Uid="Conflict_KeepBoth" Content="Beide behalten" />
                                    <ComboBoxItem x:Uid="Conflict_Ask" Content="Nicht ändern, nur melden" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                    <toolkit:SettingsCard x:Uid="Editor_Compare" Header="Änderungen erkennen" Description="Inhaltsvergleich findet auch Änderungen ohne neues Datum, ist aber deutlich langsamer.">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D5;" /></toolkit:SettingsCard.HeaderIcon>
                        <ComboBox SelectedIndex="{x:Bind ViewModel.CompareIndex, Mode=TwoWay}" MinWidth="200">
                            <ComboBoxItem x:Uid="Compare_SizeDate" Content="Größe und Datum" />
                            <ComboBoxItem x:Uid="Compare_Content" Content="Größe und Inhalt (Prüfsumme)" />
                        </ComboBox>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="Editor_Verify" Header="Kopien prüfen" Description="Jede kopierte Datei per Prüfsumme mit der Quelle vergleichen.">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE73E;" /></toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.VerifyAfterCopy, Mode=TwoWay}" OnContent="{StaticResource ToggleOnText}" OffContent="{StaticResource ToggleOffText}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="Editor_LowPriority" Header="Mit niedriger Priorität kopieren" Description="Andere Programme haben beim Zugriff auf die Laufwerke Vorrang, der PC bleibt auch bei großen Läufen flüssig. Der Lauf kann dadurch länger dauern.">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEC4A;" /></toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.LowPriorityIo, Mode=TwoWay}" OnContent="{StaticResource ToggleOnText}" OffContent="{StaticResource ToggleOffText}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsExpander x:Uid="Editor_OwnBandwidth" Header="Eigenes Bandbreitenlimit" Description="Sonst gilt das Limit aus den Einstellungen der App. Sinnvoll z. B. für ein NAS über WLAN."
                                              IsExpanded="{x:Bind ViewModel.UseOwnBandwidth, Mode=OneWay}">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xEC05;" /></toolkit:SettingsExpander.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.UseOwnBandwidth, Mode=TwoWay}" OnContent="{StaticResource ToggleOnText}" OffContent="{StaticResource ToggleOffText}" />
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Uid="Editor_OwnBandwidthValue" Header="Höchstens (KB/s)" Description="0 = unbegrenzt" IsEnabled="{x:Bind ViewModel.UseOwnBandwidth, Mode=OneWay}">
                                <NumberBox Value="{x:Bind ViewModel.OwnBandwidthKBps, Mode=TwoWay}" Minimum="0" SmallChange="1024" LargeChange="10240"
                                           SpinButtonPlacementMode="Inline" MinWidth="140" x:Uid="Editor_OwnBandwidthBox" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <!-- Filter -->
                    <TextBlock x:Uid="Editor_SectionFilter" Text="Filter" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <toolkit:SettingsExpander x:Uid="Editor_Filter" Header="Ein- und Ausschlüsse" Description="Ausgeschlossene Dateien werden weder kopiert noch im Ziel gelöscht.">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE71C;" /></toolkit:SettingsExpander.HeaderIcon>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Uid="Editor_Exclude" Header="Ausschließen" Description="Ein Muster pro Zeile, z. B. *.tmp, node_modules\ oder Projekte\**\bin\"
                                                  HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                                <TextBox Text="{x:Bind ViewModel.ExcludePatterns, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="96" FontFamily="Consolas" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Uid="Editor_Include" Header="Nur einschließen" Description="Leer = alle Dateien. Sonst nur Dateien, die einem Muster entsprechen, z. B. *.jpg"
                                                  HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                                <TextBox Text="{x:Bind ViewModel.IncludePatterns, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="64" FontFamily="Consolas" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Uid="Editor_CloudFiles" Header="Nur online verfügbare Dateien"
                                                  Description="Dateien aus OneDrive, Dropbox &amp; Co., die nicht lokal gespeichert sind. Überspringen verhindert ungewollte Downloads. Vorhandene Kopien im Ziel bleiben erhalten.">
                                <ComboBox SelectedIndex="{x:Bind ViewModel.CloudFilesIndex, Mode=TwoWay}" MinWidth="220">
                                    <ComboBoxItem x:Uid="CloudFiles_Skip" Content="Überspringen" />
                                    <ComboBoxItem x:Uid="CloudFiles_Download" Content="Herunterladen und sichern" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Uid="Editor_ExcludeHidden" Header="Versteckte Dateien ausschließen">
                                <ToggleSwitch IsOn="{x:Bind ViewModel.ExcludeHidden, Mode=TwoWay}" OnContent="{StaticResource ToggleOnText}" OffContent="{StaticResource ToggleOffText}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Uid="Editor_ExcludeSystem" Header="Systemdateien ausschließen">
                                <ToggleSwitch IsOn="{x:Bind ViewModel.ExcludeSystem, Mode=TwoWay}" OnContent="{StaticResource ToggleOnText}" OffContent="{StaticResource ToggleOffText}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Uid="Editor_MinSize" Header="Mindestgröße (MB)" Description="0 = keine Grenze">
                                <NumberBox Value="{x:Bind ViewModel.MinSizeMb, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" MinWidth="140" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Uid="Editor_MaxSize" Header="Höchstgröße (MB)" Description="0 = keine Grenze">
                                <NumberBox Value="{x:Bind ViewModel.MaxSizeMb, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" MinWidth="140" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <!-- Automatisierung -->
                    <TextBlock x:Uid="Editor_SectionAutomation" Text="Automatisierung" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <toolkit:SettingsExpander x:Uid="Editor_Schedule" Header="Zeitplan" Description="Automatisch zu festen Zeiten synchronisieren."
                                              IsExpanded="{x:Bind ViewModel.HasSchedule, Mode=OneWay}">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE787;" /></toolkit:SettingsExpander.HeaderIcon>
                        <ComboBox SelectedIndex="{x:Bind ViewModel.ScheduleIndex, Mode=TwoWay}" MinWidth="200">
                            <ComboBoxItem x:Uid="Schedule_None" Content="Kein Zeitplan" />
                            <ComboBoxItem x:Uid="Schedule_Interval" Content="In festen Abständen" />
                            <ComboBoxItem x:Uid="Schedule_Daily" Content="Täglich" />
                            <ComboBoxItem x:Uid="Schedule_Weekly" Content="An bestimmten Wochentagen" />
                        </ComboBox>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Uid="Editor_Interval" Header="Abstand (Minuten)" Visibility="{x:Bind ViewModel.IsInterval, Mode=OneWay}">
                                <NumberBox Value="{x:Bind ViewModel.IntervalMinutes, Mode=TwoWay}" Minimum="1" Maximum="10080" SmallChange="15" LargeChange="60"
                                           SpinButtonPlacementMode="Inline" MinWidth="140" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Uid="Editor_TimeOfDay" Header="Uhrzeit" Visibility="{x:Bind ViewModel.IsTimeBased, Mode=OneWay}">
                                <TimePicker Time="{x:Bind ViewModel.TimeOfDay, Mode=TwoWay}" ClockIdentifier="24HourClock" MinuteIncrement="5" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Uid="Editor_Days" Header="Wochentage" Visibility="{x:Bind ViewModel.IsWeekly, Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Days}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DayOptionViewModel">
                                            <ToggleButton Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="44" Padding="6,5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Uid="Editor_CatchUp" Header="Verpasste Termine nachholen"
                                                  Description="Lief der PC oder SyncForge zum geplanten Zeitpunkt nicht, wird beim nächsten Start einmal nachsynchronisiert."
                                                  Visibility="{x:Bind ViewModel.HasSchedule, Mode=OneWay}">
                                <ToggleSwitch IsOn="{x:Bind ViewModel.CatchUpMissed, Mode=TwoWay}" OnContent="{StaticResource ToggleOnText}" OffContent="{StaticResource ToggleOffText}" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                    <toolkit:SettingsExpander x:Uid="Editor_Watch" Header="Bei Änderungen synchronisieren"
                                              Description="Überwacht die Quelle und synchronisiert, nachdem eine Weile keine Änderungen mehr kamen."
                                              IsExpanded="{x:Bind ViewModel.WatchForChanges, Mode=OneWay}">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7B3;" /></toolkit:SettingsExpander.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.WatchForChanges, Mode=TwoWay}" OnContent="{StaticResource ToggleOnText}" OffContent="{StaticResource ToggleOffText}" />
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Uid="Editor_WatchDelay" Header="Wartezeit nach der letzten Änderung (Sekunden)">
                                <NumberBox Value="{x:Bind ViewModel.WatchDelaySeconds, Mode=TwoWay}" Minimum="2" Maximum="3600" SmallChange="5" LargeChange="30"
                                           SpinButtonPlacementMode="Inline" MinWidth="140" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                    <toolkit:SettingsCard x:Uid="Editor_RunAtStartup" Header="Beim Start von SyncForge synchronisieren"
                                          Description="Zusammen mit „Mit Windows starten“ also bei jeder Anmeldung.">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}" OnContent="{StaticResource ToggleOnText}" OffContent="{StaticResource ToggleOffText}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="Editor_RunOnDrive" Header="Wenn ein Ziel-Laufwerk angeschlossen wird"
                                          Description="Z. B. beim Einstecken der USB-Festplatte, auf der ein Ziel liegt.">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE88E;" /></toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.RunWhenTargetConnected, Mode=TwoWay}" OnContent="{StaticResource ToggleOnText}" OffContent="{StaticResource ToggleOffText}" />
                    </toolkit:SettingsCard>
                    <InfoBar x:Uid="Editor_AutomationInfo" IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,4,0,0"
                             Message="Automatische Läufe finden statt, solange SyncForge läuft, auch geschlossen im Infobereich. Bei automatischen Läufen wird ein Ziel übersprungen, wenn der Löschschutz anschlägt." />

                    <!-- Sicherheit -->
                    <TextBlock x:Uid="Editor_SectionSafety" Text="Sicherheit" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                    <toolkit:SettingsCard x:Uid="Editor_RecycleBin" Header="Gelöschte Dateien in den Papierkorb" Description="Nur auf lokalen Laufwerken möglich. Auf Netzlaufwerken wird endgültig gelöscht.">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;" /></toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.DeleteToRecycleBin, Mode=TwoWay}" OnContent="{StaticResource ToggleOnText}" OffContent="{StaticResource ToggleOffText}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsExpander x:Uid="Editor_ShadowCopy" Header="Gesperrte Dateien über Schattenkopie lesen"
                                              Description="Für Dateien, die ein Programm dauerhaft sperrt (z. B. Outlook-Datendateien). Benötigt Administratorrechte."
                                              IsExpanded="{x:Bind ViewModel.ShowShadowCopyHint, Mode=OneWay}">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8C8;" /></toolkit:SettingsExpander.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.UseShadowCopy, Mode=TwoWay}" OnContent="{StaticResource ToggleOnText}" OffContent="{StaticResource ToggleOffText}" />
                        <toolkit:SettingsExpander.ItemsHeader>
                            <InfoBar x:Uid="Editor_ShadowCopyHint" IsOpen="{x:Bind ViewModel.ShowShadowCopyHint, Mode=OneWay}" IsClosable="False" Severity="Informational"
                                     Title="Wirkt nur mit Administratorrechten"
                                     Message="SyncForge läuft gerade ohne. Richte für dieses Profil eine Aufgabe in der Windows-Aufgabenplanung ein (Mit höchsten Privilegien ausführen, Argumente: --run &quot;Profilname&quot;). Details stehen in der Hilfe unter Automatisierung." />
                        </toolkit:SettingsExpander.ItemsHeader>
                    </toolkit:SettingsExpander>
                    <toolkit:SettingsCard x:Uid="Editor_DeletionProtection" Header="Löschschutz (%)" Description="Vor dem Lauf warnen, wenn mehr als dieser Anteil der Dateien im Ziel gelöscht würde. 0 = aus.">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72E;" /></toolkit:SettingsCard.HeaderIcon>
                        <NumberBox Value="{x:Bind ViewModel.DeletionProtectionPercent, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" MinWidth="140" />
                    </toolkit:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Aktionsleiste -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="36,16">
            <StackPanel MaxWidth="1000" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Uid="Common_CancelButton" Content="Abbrechen" Click="Cancel_Click" MinWidth="120">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Escape" /></Button.KeyboardAccelerators>
                </Button>
                <Button x:Uid="Editor_SavePreview" Content="Speichern und Vorschau" Click="SavePreview_Click" />
                <Button x:Uid="Editor_Save" Content="Speichern" Click="Save_Click" MinWidth="120" Style="{StaticResource AccentButtonStyle}">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="S" /></Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
