<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncForge.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:SyncForge.Services"
    xmlns:controls="using:SyncForge.Controls"
    Background="Transparent">

    <Grid Padding="24,20,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid MaxWidth="1100" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Uid="Help_Title" Text="Hilfe" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="Help_Subtitle" Text="Anleitungen zu allen Funktionen von SyncForge." Style="{StaticResource PageSubtitleTextBlockStyle}" />
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="280" VerticalAlignment="Center" QueryIcon="Find"
                            x:Uid="Help_Search" PlaceholderText="Hilfe durchsuchen" TextChanged="SearchBox_TextChanged" />
        </Grid>

        <Grid Grid.Row="1" MaxWidth="1100" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Themen -->
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ResultText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" Margin="12,0,0,4" />
                <ListView x:Name="TopicList" Grid.Row="1" SelectionChanged="TopicList_SelectionChanged" Padding="0,0,0,24">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:HelpTopic">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="NoResults" Grid.Row="1" x:Uid="Help_NoResults" Text="Keine Treffer." Margin="12,8,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            </Grid>

            <!-- Inhalt -->
            <ScrollViewer x:Name="ContentScroller" Grid.Column="1" Padding="0,0,16,0">
                <controls:MarkdownView x:Name="TopicView" Margin="0,0,0,36" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
