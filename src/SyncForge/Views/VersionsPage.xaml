<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncForge.Views.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SyncForge.ViewModels"
    Background="Transparent">

    <Grid Padding="36,24,36,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock MaxWidth="1000" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Stretch" />

        <Grid Grid.Row="1" MaxWidth="1000" ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasRoots, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Roots}" SelectedItem="{x:Bind ViewModel.SelectedRoot, Mode=TwoWay}"
                      Visibility="{x:Bind ViewModel.ShowRootSelector, Mode=OneWay}" />
            <TextBox Grid.Column="1" Width="280" x:Uid="Versions_Search" PlaceholderText="Dateien durchsuchen"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <InfoBar Grid.Row="2" MaxWidth="1000" IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=TwoWay}" Severity="Informational"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <!-- Dateien | Fassungen -->
        <Grid Grid.Row="3" MaxWidth="1000" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasRoots, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <ListView ItemsSource="{x:Bind ViewModel.Files}" SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}" Padding="0,4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:VersionedFileItem">
                                <StackPanel Padding="4,6" Spacing="2">
                                    <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Uid="Versions_NoMatches" Text="Keine Dateien gefunden." HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="Versions_VersionsHeader" Text="Fassungen" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="16,12,16,0" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Versions}" SelectionMode="None" Padding="0,4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileVersionItem">
                                <Grid Padding="4,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind DateText}" />
                                        <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind}" Click="Restore_Click" x:Uid="Versions_Restore" ToolTipService.ToolTip="In der Quelle wiederherstellen">
                                            <FontIcon Glyph="&#xE777;" FontSize="16" />
                                        </Button>
                                        <Button Tag="{x:Bind}" Click="SaveAs_Click" x:Uid="Versions_SaveAs" ToolTipService.ToolTip="Speichern unter…">
                                            <FontIcon Glyph="&#xE792;" FontSize="16" />
                                        </Button>
                                        <Button Tag="{x:Bind}" Click="Show_Click" x:Uid="Versions_Show" ToolTipService.ToolTip="Im Explorer anzeigen">
                                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Keine Versionen -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460"
                    Visibility="{x:Bind NoRoots(ViewModel.HasRoots), Mode=OneWay}">
            <FontIcon Glyph="&#xE81C;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Uid="Versions_EmptyTitle" Text="Noch keine früheren Fassungen" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Uid="Versions_EmptyText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Im Modus „Versioniert“ werden überschriebene und gelöschte Dateien aufbewahrt und erscheinen hier." />
        </StackPanel>
    </Grid>
</Page>
